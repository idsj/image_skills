# OpenAI 兼容 API 配置（必填）
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1

# 图像生成模型（可选，默认 doubao-seedream-4-5-251128）
IMAGE_MODEL=doubao-seedream-4-5-251128
# 备选：gpt-image-2 / doubao-seedream-4-0-250828 / gemini-3-pro-image-preview

# 自定义接口地址（可选，未填时自动从 OPENAI_API_BASE_URL 派生）
# TEXT2IMAGE_API_URL=https://your-host/v1/images/generations
# IMAGE2IMAGE_API_URL=https://your-host/v1/images/edits
